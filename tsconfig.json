{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-demo/types/**/*.ts",
    ".next-demo/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-demo-e2e/types/**/*.ts",
    ".next-demo-e2e/dev/types/**/*.ts"
  ],
  // 上面 .next/dev 和其他 .next-* 目录的 include 是 Next 自动加的，删了下次运行还会加回来。这几份路由类型只在生成它的命令
  // 运行时更新，删改路由后会过期，tsc 读到就在它的 validator.ts 里报找不到页面。所以只读 .next/types：
  // typecheck 和 build 会刷新它，demo 和 e2e 的 build 也先刷新它（scripts/run-next.mjs）。
  "exclude": [
    "node_modules",
    ".next/dev",
    ".next-demo",
    ".next-e2e",
    ".next-demo-e2e"
  ]
}
