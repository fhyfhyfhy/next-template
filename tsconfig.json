{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-demo/types/**/*.ts",
    ".next-demo/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-demo-e2e/types/**/*.ts",
    ".next-demo-e2e/dev/types/**/*.ts"
  ],
  // Next adds the includes above for .next/dev and the other .next-* directories itself, and adds them back on the next run
  // when they are deleted. Those route types are updated only while the command that generates them runs, so they go stale
  // once a route is deleted or changed, and tsc then reports missing pages in their validator.ts. So only .next/types is
  // read: typecheck and build refresh it, and the demo and e2e builds refresh it first too (scripts/run-next.mjs).
  "exclude": [
    "node_modules",
    ".next/dev",
    ".next-demo",
    ".next-e2e",
    ".next-demo-e2e"
  ]
}
