{
  "name": "next-demo",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#credentials": {
      "react-server": "./lib/credentials-server.ts",
      "default": "./lib/credentials-browser.ts"
    }
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:at": "node scripts/e2e-at.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "demo:dev": "node scripts/run-next.mjs dev --demo",
    "demo:build": "node scripts/run-next.mjs build --demo",
    "demo:start": "node scripts/run-next.mjs start --demo",
    "demo:test:e2e": "playwright test --config playwright.demo.config.ts",
    "demo:generate:examples": "node scripts/demo-ui/index-generator.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mantine/hooks": "^9.7.4",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "query-string": "^10.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@next/playwright": "16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.1"
}
